# Copy to broker/.env.local (gitignored) and fill in. chmod 600. Never commit the real file,
# and never paste these values into an issue, a PR or a chat.
#
#   cd broker && (set -a; . ./.env.local; set +a; PORT=8797 node src/server.js)

# 0G Private Computer (weighs each request). Required for the real thing. From pc.0g.ai -> API keys.
ZG_API_KEY=
ZG_TIMEOUT_MS=30000

# 0G Storage (seals the record). Optional: without it the root hash is shown and "not uploaded" is said.
# A throwaway key whose address holds a little testnet gas.
ZG_PRIVATE_KEY=

# World (one real person, when a light is lit). From auth.world.org/portal (the OIDC client, not IDKit).
# For the sandbox also set WORLD_ISSUER=https://sandbox.auth.world.org and
# WORLD_JWKS=https://sandbox.auth.world.org/.well-known/jwks.json
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=

# Leave these unset for filming: they switch the real services off.
# ZG_OFFLINE=1
# WORLD_OFFLINE=1
